// ============================================
// Type mismatches in operations
// ============================================

rule TypeErrors {
    // binary operations with wrong types
    err1 = "hello" - 5
    err2 = true + false
    err3 = {a: 1} * 2
    err4 = [1, 2] / 3
    err5 = 1 in 123

    // unary operations on wrong types
    err6 = -"hello"
    err7 = !42
}

// ============================================
// Nested type errors
// ============================================

rule NestedTypeErrors {
    obj = {
        num: 42,
        str: "hello",
        bool: true,
        nested: {
            value: 100
        }
    }
    
    // trying to access properties on primitives
    err1 = obj.num.invalid
    err2 = obj.str.field
    err3 = obj.bool.property
    
    // correct access, then wrong operation
    err4 = obj.nested.value.something
    
    // indexing primitives
    err5 = obj.num[0]
    err6 = obj.str[0]
    err7 = obj.bool["key"]
}

// ============================================
// Array type checking
// ============================================

rule ArrayTypeChecking {
    numbers = [1, 2, 3, 4, 5]
    objects = [{id: 1}, {id: 2}, {id: 3}]
    nested = [[1, 2], [3, 4], [5, 6]]
    
    // wrong index types
    err1 = numbers["string"]
    err2 = numbers[true]
    err3 = numbers[{key: "value"}]
    
    // out of bounds (compile-time detectable)
    err4 = numbers[10]
    err5 = numbers[-1]
    err6 = objects[5].id
    err7 = nested[0][5]
    err8 = nested[10][0]
    
    // correct indexing but wrong property
    err9 = objects[0].missing
    err10 = objects[1].nonexistent.field
}

// ============================================
// Conditional expression type consistency
// ============================================

rule ConditionalTypes {
    // branches should have the same type
    err1 = true ? 42 : "hello"  // number vs string
    err2 = false ? {a: 1} : [1, 2, 3]  // object vs array
    err3 = true ? true : 123  // bool vs number
    
    // non-boolean conditions
    err4 = 42 ? "yes" : "no"
    err5 = "hello" ? 1 : 2
    err6 = {a: 1} ? true : false
}

// ============================================
// Complex chaining errors
// ============================================

rule ChainedAccessErrors {
    data = {
        users: [
            {
                name: "Alice",
                posts: [
                    {title: "First", likes: 10},
                    {title: "Second", likes: 20}
                ]
            },
            {
                name: "Bob",
                posts: [
                    {title: "Hello", likes: 5}
                ]
            }
        ]
    }
    
    // valid accesses
    ok1 = data.users[0].name
    ok2 = data.users[0].posts[0].title
    ok3 = data.users[1].posts[0].likes
    
    // error: wrong property names
    err1 = data.users[0].age
    err2 = data.users[0].posts[0].content
    err3 = data.members[0].name
    
    // error: out of bounds
    err4 = data.users[5].name
    err5 = data.users[0].posts[10].title
    
    // error: chaining after primitive
    err6 = data.users[0].name.uppercase
    err7 = data.users[0].posts[0].likes.double
}

// ============================================
// Reserved input object testing
// ============================================

rule InputObjectTests {
    // these should work semantically
    x1 = input.userId
    x2 = input.data.items[0].id
    x3 = input.settings.theme.color
    
    // mixed with local variables
    config = {
        defaultTheme: input.settings.theme,
        user: {
            id: input.userId,
            name: input.userName
        }
    }
    
    x4 = config.defaultTheme.color
    x5 = config.user.id
}

// ============================================
// Scope
// ============================================

rule ScopeTests {
    x = 10
    y = x + 5  // x is in scope
    
    obj = {
        x: 20,  // different x (property)
        y: x    // outer x
    }
    
    z = obj.x
}

// ============================================
// Undefined variables
// ============================================

rule UndefinedVars {
    err1 = undefinedVar
    err2 = someVar.property
    err3 = missing[0]
    err4 = notDefined.chain.of.props
    
    // reference before definition
    err5 = futureVar
    futureVar = 42
}

// ============================================
// Complex mixed operations
// ============================================

rule MixedOperations {
    users = [
        {name: "Alice", age: 30, tags: ["admin", "user"]},
        {name: "Bob", age: 25, tags: ["user"]},
        {name: "Charlie", age: 35, tags: ["admin", "moderator", "user"]}
    ]
    
    // valid complex expressions
    ok1 = users[0].tags[0]
    ok2 = users[2].tags[1]
    ok3 = users[1].age + 5
    
    // errors in complex expressions
    err1 = users[0].name + " is " + users[0].age // string + number
    err2 = users[0].tags[5]  // out of bounds
    err3 = users[5].name  // out of bounds
    err4 = users[0].missing[0]  // missing property
    err5 = users[0].tags.invalid  // array doesn't have properties
    err6 = users[0].age.field  // number doesn't have properties
}

// ============================================
// String/Object indexing edge cases
// ============================================

rule IndexingEdgeCases {
    obj = {
        "normal-key": 1,
        "key.with.dots": 2,
        "key[with]brackets": 3
    }
    
    x1 = obj["normal-key"]
    x2 = obj["key.with.dots"]
    x3 = obj["key[with]brackets"]
    
    // wrong index type on object
    err1 = obj[123]
    err2 = obj[true]
    err3 = obj[[1, 2, 3]]
}

// ============================================
// Homogeneous vs heterogeneous arrays
// ============================================

rule ArrayElementTypes {
    // homogeneous arrays
    numbers = [1, 2, 3, 4, 5]
    strings = ["a", "b", "c"]
    
    // heterogeneous arrays
    mixed = [1, "hello", true, {key: "value"}, [1, 2]]
    
    x1 = mixed[0]  // number
    x2 = mixed[1]  // string
    x3 = mixed[2]  // bool
    x4 = mixed[3].key  // object property
    x5 = mixed[4][0]  // nested array element
    
    // Type errors
    err1 = mixed[0].property  // number doesn't have properties
    err2 = mixed[1][0]  // string indexing
}