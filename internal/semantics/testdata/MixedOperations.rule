rule MixedOperations {
    users = [
        {name: "Alice", age: 30, tags: ["admin", "user"]},
        {name: "Bob", age: 25, tags: ["user"]},
        {name: "Charlie", age: 35, tags: ["admin", "moderator", "user"]}
    ]
    
    // valid complex expressions
    ok1 = users[0].tags[0]
    ok2 = users[2].tags[1]
    ok3 = users[1].age + 5
    
    // errors in complex expressions
    err1 = users[0].name + " is " + users[0].age  // ERROR: operator '+' cannot be applied to 'string' and 'number'
    err2 = users[0].tags[5]                       // ERROR: array index 5 out of bounds (length 2)
    err3 = users[5].name                          // ERROR: array index 5 out of bounds (length 3)
    err4 = users[0].missing[0]                    // ERROR: unknown property 'missing' on object 'users[0]'
    err5 = users[0].tags.invalid                  // ERROR: cannot access property 'invalid' on type array<string>
    err6 = users[0].age.field                     // ERROR: cannot access property 'field' on type number
}